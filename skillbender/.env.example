# Copy to .env and fill in your values (never commit .env)

# LLM API Keys (set whichever provider you use)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
OLLAMA_BASE_URL=http://localhost:11434/api

# SkillBender overrides (optional — prefer .skillbender/config.yaml)
SKILLBENDER_LLM_PROVIDER=anthropic
SKILLBENDER_LLM_MODEL=claude-sonnet-4-6
SKILLBENDER_LOG_LEVEL=info
SKILLBENDER_LOG_FORMAT=pretty
